{
  "name": "local-ai-chat-frontend",
  "private": false,
  "version": "1.2.3",
  "description": "A privacy-first, browser-based chat interface for local LLMs (Ollama, GPT4ALL, LM Studio, llama.cpp) and cloud providers. No backend required.",
  "type": "module",
  "packageManager": "bun@1.2.20",
  "license": "MIT",
  "author": "hidao80",
  "homepage": "https://github.com/hidao80/local-ai-chat-frontend#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hidao80/local-ai-chat-frontend.git"
  },
  "bugs": {
    "url": "https://github.com/hidao80/local-ai-chat-frontend/issues"
  },
  "keywords": [
    "llm",
    "chat",
    "ollama",
    "gpt4all",
    "lm-studio",
    "llama.cpp",
    "local-llm",
    "openai",
    "privacy",
    "react",
    "vite"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "local-ai-chat-frontend": "bin/start.js"
  },
  "files": [
    "bin",
    "dist",
    "public"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prepare": "bun run build",
    "prepack": "bun run build",
    "lint": "biome lint",
    "format": "biome format",
    "preview": "vite preview",
    "start": "node bin/start.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "screenshot": "playwright test tests/e2e/screenshot.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:gui": "playwright test --project=functional",
    "act": "act",
    "act:audit": "act -j audit",
    "act:build": "act -j build",
    "act:lint": "act -j lint"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.16",
    "i18next": "^26.4.3",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "sirv": "^3.0.2",
    "sonner": "^2.0.8",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
